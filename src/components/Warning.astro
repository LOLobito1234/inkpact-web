---
import PixelIcon from './PixelIcon.astro';

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div class="flex gap-4 border-l-4 border-warning bg-warning/10 p-4">
  <PixelIcon name="alert" size={24} class="mt-0.5 text-warning" />
  <div>
    <p class="mb-1 font-semibold text-text">{title}</p>
    <p class="text-sm leading-relaxed text-text-muted">{text}</p>
  </div>
</div>
