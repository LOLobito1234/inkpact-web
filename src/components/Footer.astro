---
import type { Translations } from '../i18n/es';
import { REPO_URL } from '../config';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<footer class="border-t border-border bg-bg py-12">
  <div class="mx-auto max-w-[1120px] px-4 md:px-6">
    <div class="flex flex-col items-center gap-6 text-center">
      <!-- Brand -->
      <span class="font-pixel text-lg font-bold tracking-wider text-accent">INKPACT</span>

      <!-- Links -->
      <div class="flex flex-wrap justify-center gap-4 font-pixel text-xs uppercase tracking-wider">
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="text-text-muted transition-colors hover:text-accent">
          {t.footer.github}
        </a>
        <span class="text-border" aria-hidden="true">·</span>
        <a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="text-text-muted transition-colors hover:text-accent">
          {t.footer.issues}
        </a>
        <span class="text-border" aria-hidden="true">·</span>
        <span class="text-text-muted">{t.footer.license}</span>
      </div>

      <!-- Legal -->
      <p class="max-w-2xl text-xs leading-relaxed text-text-muted">
        {t.footer.legal}
      </p>
    </div>
  </div>
</footer>
