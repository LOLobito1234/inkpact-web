---
import PixelIcon, { type IconName } from './PixelIcon.astro';

interface Props {
  slot: string;
  icon: IconName;
  title: string;
  text: string;
}

const { slot, icon, title, text } = Astro.props;
---

<div
  class="reveal group flex items-start gap-4 border border-border bg-bg-elevated p-5 transition-all duration-150 pixel-corners hover:-translate-x-0.5 hover:-translate-y-0.5 hover:border-accent"
  style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink)); transition: filter 120ms steps(2);"
>
  <div
    class="flex size-11 shrink-0 items-center justify-center border-2 border-pixel-ink bg-bg-board text-accent pixel-corners-sm"
  >
    <PixelIcon name={icon} size={22} />
  </div>
  <div class="min-w-0">
    <span class="mb-1 block font-pixel text-[11px] uppercase tracking-widest text-accent">
      {slot}
    </span>
    <h3 class="mb-1.5 font-pixel text-base font-bold uppercase tracking-wider text-text">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-text-muted">{text}</p>
  </div>
</div>

<style>
  .group:hover {
    filter: drop-shadow(8px 8px 0 var(--color-pixel-ink)) !important;
  }
</style>
