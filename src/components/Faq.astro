---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-3" role="region" aria-label="FAQ">
  {items.map((item, i) => (
    <details
      class="group border border-border bg-bg-elevated transition-colors pixel-corners open:border-accent"
    >
      <summary class="flex min-h-[44px] cursor-pointer select-none items-center justify-between gap-4 px-5 py-4 font-medium text-text">
        <span>{item.q}</span>
        <span class="faq-icon shrink-0 font-pixel text-lg text-text-muted transition-transform duration-250 group-open:rotate-45">
          +
        </span>
      </summary>
      <div class="px-5 pb-5 text-sm leading-relaxed text-text-muted">
        {item.a}
      </div>
    </details>
  ))}
</div>
