---
import type { IconName } from '../types/icons';

export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['pixel-render shrink-0', cls]}
  aria-hidden="true"
>
  {name === 'logo' && (
    <>
      <rect x="2" y="2" width="12" height="12" fill="currentColor" opacity="0.2" />
      <rect x="4" y="3" width="8" height="2" />
      <rect x="7" y="5" width="2" height="6" />
      <rect x="4" y="11" width="8" height="2" />
    </>
  )}
  {name === 'pencil' && (
    <>
      <rect x="10" y="2" width="3" height="3" />
      <rect x="8" y="4" width="3" height="3" />
      <rect x="6" y="6" width="3" height="3" />
      <rect x="4" y="8" width="3" height="3" />
      <rect x="2" y="10" width="3" height="3" />
      <rect x="2" y="12" width="2" height="2" />
    </>
  )}
  {name === 'laser' && (
    <>
      <rect x="7" y="1" width="2" height="4" />
      <rect x="7" y="11" width="2" height="4" />
      <rect x="1" y="7" width="4" height="2" />
      <rect x="11" y="7" width="4" height="2" />
      <rect x="6" y="6" width="4" height="4" />
    </>
  )}
  {name === 'shield' && (
    <>
      <rect x="3" y="2" width="10" height="2" />
      <rect x="2" y="4" width="12" height="5" />
      <rect x="3" y="9" width="10" height="2" />
      <rect x="5" y="11" width="6" height="2" />
      <rect x="7" y="13" width="2" height="1" />
    </>
  )}
  {name === 'users' && (
    <>
      <rect x="3" y="3" width="4" height="4" />
      <rect x="2" y="8" width="6" height="5" />
      <rect x="9" y="4" width="4" height="4" />
      <rect x="9" y="9" width="5" height="4" />
    </>
  )}
  {name === 'freeze' && (
    <>
      <rect x="7" y="1" width="2" height="14" />
      <rect x="1" y="7" width="14" height="2" />
      <rect x="3" y="3" width="2" height="2" />
      <rect x="11" y="3" width="2" height="2" />
      <rect x="3" y="11" width="2" height="2" />
      <rect x="11" y="11" width="2" height="2" />
    </>
  )}
  {name === 'pages' && (
    <>
      <rect x="3" y="2" width="8" height="10" fill="none" stroke="currentColor" stroke-width="2" />
      <rect x="6" y="5" width="7" height="9" />
    </>
  )}
  {name === 'keyboard' && (
    <>
      <rect x="1" y="4" width="14" height="8" fill="none" stroke="currentColor" stroke-width="2" />
      <rect x="3" y="6" width="2" height="2" />
      <rect x="6" y="6" width="2" height="2" />
      <rect x="9" y="6" width="2" height="2" />
      <rect x="4" y="9" width="8" height="1" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="5" y="2" width="6" height="2" />
      <rect x="4" y="4" width="2" height="3" />
      <rect x="10" y="4" width="2" height="3" />
      <rect x="3" y="7" width="10" height="7" />
    </>
  )}
  {name === 'zip' && (
    <>
      <rect x="3" y="2" width="10" height="12" fill="none" stroke="currentColor" stroke-width="2" />
      <rect x="7" y="4" width="2" height="2" />
      <rect x="7" y="7" width="2" height="2" />
      <rect x="6" y="10" width="4" height="2" />
    </>
  )}
  {name === 'play' && (
    <>
      <rect x="4" y="2" width="2" height="12" />
      <rect x="6" y="3" width="2" height="10" />
      <rect x="8" y="4" width="2" height="8" />
      <rect x="10" y="6" width="2" height="4" />
      <rect x="12" y="7" width="1" height="2" />
    </>
  )}
  {name === 'coffee' && (
    <>
      <rect x="4" y="2" width="2" height="2" />
      <rect x="8" y="2" width="2" height="2" />
      <rect x="3" y="5" width="9" height="8" />
      <rect x="12" y="6" width="2" height="5" />
      <rect x="2" y="13" width="11" height="2" />
    </>
  )}
  {name === 'alert' && (
    <>
      <rect x="7" y="2" width="2" height="2" />
      <rect x="5" y="4" width="6" height="2" />
      <rect x="4" y="6" width="8" height="3" />
      <rect x="2" y="9" width="12" height="4" />
      <rect x="7" y="5" width="2" height="4" fill="#14161D" />
      <rect x="7" y="10" width="2" height="2" fill="#14161D" />
    </>
  )}
  {name === 'check' && (
    <>
      <rect x="12" y="3" width="2" height="2" />
      <rect x="10" y="5" width="2" height="2" />
      <rect x="8" y="7" width="2" height="2" />
      <rect x="6" y="9" width="2" height="2" />
      <rect x="4" y="7" width="2" height="2" />
      <rect x="2" y="5" width="2" height="2" />
    </>
  )}
</svg>
