---
interface Props {
  label: string;
  delay?: number;
}

const { label, delay = 0 } = Astro.props;
---

<kbd
  class="keycap inline-flex items-center justify-center border-2 border-pixel-ink bg-bg-board px-3 py-1.5 font-pixel text-sm text-text shadow-[0_3px_0_var(--color-pixel-ink)] transition-transform pixel-corners-sm"
  style={`animation-delay: ${delay}ms;`}
>
  {label}
</kbd>

<style>
  .keycap:active {
    transform: translateY(3px);
    box-shadow: none;
  }
</style>
