---
import type { Translations } from '../i18n/es';
import { VERSION } from '../config';
import DownloadButton from './DownloadButton.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
const altLang = isEn ? 'es' : 'en';
const altHref = isEn ? '/' : '/en/';
---

<nav
  id="navbar"
  class="fixed top-4 left-1/2 z-50 w-[calc(100%-32px)] max-w-[1120px] -translate-x-1/2 border-3 border-pixel-ink bg-bg-elevated transition-all duration-200 pixel-corners"
  style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink));"
  aria-label="Main navigation"
>
  <div class="flex items-center justify-between gap-4 px-5 py-3.5 md:px-7">
    <!-- Left: Logo + Subtitle -->
    <a href={isEn ? '/en/' : '/'} class="flex min-h-[44px] items-center gap-3">
      <span
        class="flex size-10 items-center justify-center border-2 border-pixel-ink bg-accent text-bg pixel-corners-sm"
      >
        <PixelIcon name="logo" size={22} />
      </span>
      <div class="leading-tight">
        <span class="block font-pixel text-lg font-bold tracking-wider text-text">INKPACT</span>
        <span class="hidden font-pixel text-[11px] tracking-widest text-text-muted sm:block">
          {t.nav.subtitle}
        </span>
      </div>
    </a>

    <!-- Center: Nav links + Version badge -->
    <div class="hidden items-center gap-5 lg:flex">
      <a
        href="#steps"
        class="nav-link inline-flex min-h-[44px] items-center px-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors hover:text-accent"
      >
        {t.nav.steps}
      </a>
      <a
        href="#features"
        class="nav-link inline-flex min-h-[44px] items-center px-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors hover:text-accent"
      >
        {t.nav.features}
      </a>
      <a
        href="#games"
        class="nav-link inline-flex min-h-[44px] items-center px-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors hover:text-accent"
      >
        {t.nav.games}
      </a>
      <a
        href="#security"
        class="nav-link inline-flex min-h-[44px] items-center px-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors hover:text-accent"
      >
        {t.nav.security}
      </a>
      <a
        href="#faq"
        class="nav-link inline-flex min-h-[44px] items-center px-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors hover:text-accent"
      >
        {t.nav.faq}
      </a>
    </div>

    <!-- Right: Version badge + Lang switcher + DownloadButton -->
    <div class="flex items-center gap-3">
      <span
        class="hidden border-2 border-warning/70 bg-bg-board px-2.5 py-1 font-pixel text-xs uppercase tracking-wider text-warning pixel-corners-sm xl:inline-block"
        data-version-badge
      >
        VER {VERSION} [PORT]
      </span>

      <a
        href={altHref}
        class="flex min-h-[44px] min-w-[44px] items-center justify-center border-2 border-pixel-ink bg-bg-board px-3 py-1 font-pixel text-sm uppercase tracking-wider text-text transition-colors pixel-corners-sm hover:border-accent hover:text-accent"
        aria-label={`Switch to ${altLang === 'en' ? 'English' : 'Español'}`}
      >
        {altLang.toUpperCase()}
      </a>

      <div class="hidden md:block">
        <DownloadButton label={t.nav.download} size="sm" />
      </div>

      <!-- Mobile / Tablet hamburger -->
      <button
        id="menu-toggle"
        type="button"
        class="flex size-12 items-center justify-center border-2 border-pixel-ink bg-bg-board text-text pixel-corners-sm hover:border-accent hover:text-accent lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="font-pixel text-xl" aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <!-- Mobile / Tablet submenu -->
  <div id="mobile-menu" class="hidden border-t-2 border-border bg-bg-elevated px-5 pb-5 lg:hidden">
    <div class="flex flex-col divide-y divide-border pt-2">
      <a
        href="#steps"
        class="mobile-nav-link flex min-h-[48px] items-center px-2 font-pixel text-base uppercase tracking-wider text-text transition-colors hover:bg-hover hover:text-accent"
      >
        {t.nav.steps}
      </a>
      <a
        href="#features"
        class="mobile-nav-link flex min-h-[48px] items-center px-2 font-pixel text-base uppercase tracking-wider text-text transition-colors hover:bg-hover hover:text-accent"
      >
        {t.nav.features}
      </a>
      <a
        href="#games"
        class="mobile-nav-link flex min-h-[48px] items-center px-2 font-pixel text-base uppercase tracking-wider text-text transition-colors hover:bg-hover hover:text-accent"
      >
        {t.nav.games}
      </a>
      <a
        href="#security"
        class="mobile-nav-link flex min-h-[48px] items-center px-2 font-pixel text-base uppercase tracking-wider text-text transition-colors hover:bg-hover hover:text-accent"
      >
        {t.nav.security}
      </a>
      <a
        href="#faq"
        class="mobile-nav-link flex min-h-[48px] items-center px-2 font-pixel text-base uppercase tracking-wider text-text transition-colors hover:bg-hover hover:text-accent"
      >
        {t.nav.faq}
      </a>
      <div class="pt-4">
        <DownloadButton label={t.nav.download} size="sm" class="w-full" />
      </div>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');

  function onScroll() {
    const y = window.scrollY;
    if (!navbar) return;
    if (y > 80) {
      navbar.style.filter = 'drop-shadow(8px 8px 0 var(--color-pixel-ink))';
    } else {
      navbar.style.filter = 'drop-shadow(4px 4px 0 var(--color-pixel-ink))';
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    const icon = toggle.querySelector('span');
    if (icon) icon.textContent = isOpen ? '✕' : '☰';
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      const icon = toggle?.querySelector('span');
      if (icon) icon.textContent = '☰';
    });
  });
</script>
