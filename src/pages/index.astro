---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Card from '../components/Card.astro';
import StepCard from '../components/StepCard.astro';
import Chip from '../components/Chip.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Warning from '../components/Warning.astro';
import Faq from '../components/Faq.astro';
import DemoFrame from '../components/DemoFrame.astro';
import Footer from '../components/Footer.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { t } from '../i18n';
import { REPO_URL, DONATE_URL } from '../config';

const locale = Astro.currentLocale ?? 'es';
const i = t(locale);
---

<Base t={i}>
  <Navbar t={i} />

  <!-- ═══ HERO (Video background, Stitch typography & CTAs) ═══ -->
  <section
    id="hero"
    class="relative flex min-h-[100svh] items-center justify-center overflow-hidden"
  >
    <!-- Video background -->
    <!-- TODO: Replace poster (/video/hero-poster.jpg) and video sources (/video/hero.webm, /video/hero.mp4) with real assets -->
    <video
      id="hero-video"
      class="pointer-events-none absolute inset-0 size-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/video/hero.webm" type="video/webm" />
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>

    <!-- Solid dark overlay (~70% opacity for AA contrast) -->
    <div class="absolute inset-0 bg-[#14161D]/70" aria-hidden="true"></div>

    <!-- Subtle pixel dither texture -->
    <div class="dither-overlay absolute inset-0" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-10 mx-auto max-w-[1120px] px-4 py-32 text-center md:px-6">
      <p class="mb-4 font-pixel text-xs font-bold uppercase tracking-widest text-warning">
        {i.hero.badge}
      </p>

      <h1
        id="hero-headline"
        class="mx-auto mb-6 max-w-4xl font-pixel text-3xl font-bold uppercase leading-[1.15] tracking-[0.02em] text-text md:text-[56px]"
        aria-label={i.hero.headline}
      >
        {i.hero.headline}
      </h1>

      <p class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-text-muted md:text-lg">
        {i.hero.sub}
      </p>

      <div class="flex flex-col items-center justify-center gap-5 sm:flex-row">
        <DownloadButton
          label={i.hero.cta}
          size="hero"
          showFreeBadge={true}
          freeLabel={i.hero.freeBadge}
        />
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center justify-center border-3 border-text bg-transparent px-8 py-5 font-pixel text-base font-bold uppercase tracking-wider text-text transition-all pixel-corners hover:translate-x-1 hover:translate-y-1 hover:bg-hover sm:px-10 sm:py-6 sm:text-xl"
          style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink));"
        >
          {i.hero.github}
        </a>
      </div>

      <p
        class="mt-6 font-pixel text-xs tracking-wider text-text-muted"
        data-download-meta
      >
        {i.hero.meta}
      </p>

      <!-- Accessible video pause/play button -->
      <button
        id="video-toggle"
        type="button"
        class="fixed bottom-6 right-6 z-40 flex size-11 items-center justify-center border-2 border-pixel-ink bg-bg-elevated font-pixel text-sm text-text-muted transition-colors pixel-corners-sm hover:border-accent hover:text-accent"
        aria-label={i.hero.videoPause}
        data-pause-label={i.hero.videoPause}
        data-play-label={i.hero.videoPlay}
      >
        ⏸
      </button>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══════════════════════════════════════ -->
  <section id="steps" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 md:px-6">
      <h2 class="reveal mb-2 text-center font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
        {i.steps.title}
      </h2>
      <p class="reveal mb-12 text-center font-pixel text-xs uppercase tracking-widest text-text-muted">
        {i.steps.subtitle}
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {i.steps.items.map((step, idx) => (
          <StepCard
            num={step.num}
            icon={step.icon}
            accentColor={step.accentColor}
            title={step.title}
            text={step.text}
            status={step.status}
            keys={'keys' in step ? step.keys : undefined}
            delay={idx * 80}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURES ═══════════════════════════════════════════ -->
  <section id="features" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 md:px-6">
      <h2 class="reveal mb-2 text-center font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
        {i.features.title}
      </h2>
      <p class="reveal mb-12 text-center font-pixel text-xs uppercase tracking-widest text-text-muted">
        {i.features.subtitle}
      </p>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {i.features.items.map((feat) => (
          <Card slot={feat.slot} icon={feat.icon} title={feat.title} text={feat.text} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ DEMO ═══════════════════════════════════════════════ -->
  <section id="demo" class="py-16 md:py-24">
    <div class="mx-auto max-w-[800px] px-4 md:px-6">
      <div class="reveal">
        <DemoFrame title="INKPACT_DEMO.EXE">
          <img
            src="/images/demo-capture.png"
            alt="Captura real de Inkpact mostrando una composición Dive con 5 fichas de personajes y una zona táctica roja"
            class="block h-auto w-full border border-border object-cover"
            loading="lazy"
            decoding="async"
          />
          <p class="mt-3 font-pixel text-xs uppercase tracking-wider text-text-muted">
            Composición Dive armada con fichas de equipo y zona táctica flotando sobre la pantalla.
          </p>
        </DemoFrame>
      </div>
    </div>
  </section>

  <!-- ═══ COMPATIBLE GAMES ═══════════════════════════════════ -->
  <section id="games" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 md:px-6">
      <div
        class="reveal border border-border bg-bg-elevated p-8 text-center pixel-corners"
        style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink));"
      >
        <p class="mb-2 font-pixel text-xs uppercase tracking-widest text-text-muted">
          {i.games.eyebrow}
        </p>
        <h2 class="mb-4 font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
          {i.games.title}
        </h2>
        <p class="mb-6 text-sm text-text-muted">{i.games.sub}</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {i.games.list.map((game) => (
            <Chip label={game} />
          ))}
          <span class="inline-block border-2 border-accent bg-bg-board px-3 py-1.5 font-pixel text-xs uppercase tracking-wider text-accent pixel-corners-sm">
            {i.games.anyGame}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SECURITY ═══════════════════════════════════════════ -->
  <section id="security" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 md:px-6">
      <div
        class="reveal mx-auto max-w-3xl border-3 border-pixel-ink bg-bg-elevated p-6 md:p-8 pixel-corners"
        style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink));"
      >
        <div class="mb-6 flex items-center gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center border-2 border-pixel-ink bg-bg-board text-accent pixel-corners-sm">
            <PixelIcon name="shield" size={26} />
          </div>
          <h2 class="font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
            {i.security.title}
          </h2>
        </div>

        <ul class="mb-6 space-y-3">
          {i.security.checks.map((check) => (
            <li class="flex items-start gap-3">
              <PixelIcon name="check" size={18} class="mt-1 text-accent" />
              <span class="text-sm text-text-muted md:text-base">{check}</span>
            </li>
          ))}
        </ul>

        <div class="mb-6">
          <p class="mb-2 font-pixel text-xs uppercase tracking-wider text-text">
            {i.security.hashLabel}
          </p>
          <CodeBlock
            code={i.security.hashCmd}
            copyLabel={i.security.copyLabel}
            copiedLabel={i.security.copiedLabel}
          />
        </div>

        <Warning
          title={i.security.smartscreen.title}
          text={i.security.smartscreen.text}
        />
      </div>
    </div>
  </section>

  <!-- ═══ DONATE ═════════════════════════════════════════════ -->
  <section id="donate" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 md:px-6">
      <div
        class="reveal mx-auto flex max-w-3xl flex-col items-center justify-between gap-6 border border-border bg-bg-elevated p-6 text-center md:flex-row md:p-8 md:text-left pixel-corners"
        style="filter: drop-shadow(4px 4px 0 var(--color-pixel-ink));"
      >
        <div class="flex flex-col items-center gap-4 md:flex-row">
          <div class="flex size-12 shrink-0 items-center justify-center border-2 border-pixel-ink bg-bg-board text-warning pixel-corners-sm">
            <PixelIcon name="coffee" size={24} />
          </div>
          <div>
            <p class="mb-1 font-pixel text-[11px] uppercase tracking-widest text-warning">
              {i.donate.eyebrow}
            </p>
            <h2 class="mb-1 font-pixel text-lg font-bold uppercase tracking-wider text-text">
              {i.donate.title}
            </h2>
            <p class="max-w-lg text-sm text-text-muted">{i.donate.text}</p>
          </div>
        </div>
        <a
          href={DONATE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] shrink-0 items-center justify-center border-3 border-warning bg-transparent px-6 py-3 font-pixel text-sm font-bold uppercase tracking-wider text-warning transition-all pixel-corners-sm hover:translate-x-0.5 hover:translate-y-0.5 hover:bg-warning/10"
        >
          {i.donate.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ════════════════════════════════════════════════ -->
  <section id="faq" class="py-16 md:py-24">
    <div class="mx-auto max-w-[800px] px-4 md:px-6">
      <h2 class="reveal mb-12 text-center font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
        {i.faq.title}
      </h2>
      <div class="reveal">
        <Faq items={i.faq.items} />
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ══════════════════════════════════════════ -->
  <section id="cta" class="py-16 md:py-24">
    <div class="mx-auto max-w-[1120px] px-4 text-center md:px-6">
      <h2 class="reveal mb-4 font-pixel text-2xl font-bold uppercase tracking-wider text-text md:text-[32px]">
        {i.cta.title}
      </h2>
      <p class="reveal mb-8 text-text-muted">{i.cta.sub}</p>
      <div class="reveal">
        <DownloadButton label={i.cta.btn} size="hero" />
      </div>
      <p class="reveal mt-5 font-pixel text-xs uppercase tracking-wider text-text-muted" data-download-meta>
        {i.cta.meta}
      </p>
    </div>
  </section>

  <Footer t={i} />
</Base>

<script>
  // ── Hero typewriter ────────────────────────────────────────
  const headline = document.getElementById('hero-headline');
  const text = headline?.getAttribute('aria-label') ?? '';

  function typewriter(el: HTMLElement, str: string) {
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!motionOk) {
      el.textContent = str;
      return;
    }
    el.textContent = '';
    el.classList.add('typewriter-cursor');
    let idx = 0;
    const interval = setInterval(() => {
      el.textContent = str.slice(0, ++idx);
      if (idx >= str.length) {
        clearInterval(interval);
      }
    }, Math.max(20, Math.floor(1200 / str.length)));
  }

  if (headline && text) {
    typewriter(headline, text);
  }

  // ── Video background controls (reduced motion, saveData, error, toggle) ──
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggleBtn = document.getElementById('video-toggle');

  if (video && toggleBtn) {
    const motionReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const saveData = Boolean(conn?.saveData);
    const pauseLabel = toggleBtn.dataset.pauseLabel ?? 'Pause';
    const playLabel = toggleBtn.dataset.playLabel ?? 'Play';

    if (motionReduced || saveData) {
      video.removeAttribute('autoplay');
      video.pause();
      toggleBtn.textContent = '▶';
      toggleBtn.setAttribute('aria-label', playLabel);
    }

    video.addEventListener('error', () => {
      video.style.display = 'none';
      toggleBtn.style.display = 'none';
    });

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play().catch(() => {});
        toggleBtn.textContent = '⏸';
        toggleBtn.setAttribute('aria-label', pauseLabel);
      } else {
        video.pause();
        toggleBtn.textContent = '▶';
        toggleBtn.setAttribute('aria-label', playLabel);
      }
    });
  }
</script>
